{
	"name": "jsaari97/inskrift",
	"description": "A small, modern, and privacy-friendly guestbook plugin for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Jim Saari"
		}
	],
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.7",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.2",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Inskrift\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Inskrift\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.4.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
		"check": [
			"@lint",
			"@analyse",
			"@test:unit"
		],
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "@test:unit",
		"test:integration": "phpunit --configuration=phpunit.integration.xml.dist",
		"test:unit": "phpunit --configuration=phpunit.xml.dist"
	}
}
